{
  "name": "Schedule Widget",
  "short_name": "Schedule",
  "description": "A small schedule window. The box for right now slowly pulses red.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
